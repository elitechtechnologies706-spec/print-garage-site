# Copy/source this file in a cPanel terminal. Replace only the non-password values.
# Leave PG_FTP_PASSWORD blank to receive a hidden interactive password prompt.
# Do not commit real FTP credentials or place them in this example file.

export PG_FTP_HOST="YOUR_CPANEL_FTP_HOST"
export PG_FTP_USER="YOUR_CPANEL_FTP_USERNAME"
export PG_FTP_PASSWORD=""
export PG_FTP_UPLOADS_PATH="public_html/wp-content/uploads"
export PG_FTP_USE_TLS="1"
export PG_WP_PATH="/home/YOUR_CPANEL_USERNAME/public_html"

# Optional: choose a private directory outside public_html for the SQL backup.
# export PG_DB_BACKUP_DIR="/home/YOUR_CPANEL_USERNAME/private-backups"
